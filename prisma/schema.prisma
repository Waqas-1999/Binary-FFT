/// Archive: every schema change ships as a migration (`pnpm db:migrate`).

generator client {
  provider            = "prisma-client"
  output              = "../services/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthEventType {
  SIGNUP_STARTED
  USER_CREATED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED
  GOOGLE_LOGIN_STARTED
  GOOGLE_LOGIN_SUCCESS
  GOOGLE_LOGIN_FAILED
  GOOGLE_LINK_STARTED
  GOOGLE_LINK_SUCCESS
  GOOGLE_LINK_FAILED
  GOOGLE_LINK_CONFLICT
  TWO_FACTOR_SETUP_STARTED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_FAILED
  TWO_FACTOR_DISABLED
  RECOVERY_CODES_GENERATED
  RECOVERY_CODE_USED
  RECOVERY_CODES_REGENERATED
  SESSIONS_REVOKED
  PASSWORD_CHANGED
  REAUTHENTICATION_SUCCESS
  REAUTHENTICATION_FAILED
  NEW_LOGIN
  NEW_LOGIN_2FA_REQUIRED
  PROFILE_UPDATED
  PHONE_VERIFICATION_REQUESTED
  PHONE_VERIFICATION_FAILED
  PHONE_VERIFIED
  PHONE_CHANGED
  PHONE_REMOVED
  TELEGRAM_LINK_STARTED
  TELEGRAM_LINKED
  TELEGRAM_LINK_CONFLICT
  TELEGRAM_UNLINKED
  NOTIFICATION_PREFERENCES_UPDATED
}

model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Public user ID, starting at 10000. Generated by a PostgreSQL identity column (never reused,
  /// rejects client-supplied values) and made immutable by a trigger; see the identity migration.
  userNumber  Int        @unique @default(autoincrement()) @map("user_number")
  status      UserStatus @default(ACTIVE)
  /// Optional name shown on the account. Not unique, not an identity; plain text only.
  displayName String?    @map("display_name") @db.VarChar(50)
  /// IANA time zone chosen by the user; null follows the device.
  timeZone    String?    @map("time_zone") @db.VarChar(64)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  emailAccount           EmailAccount?
  sessions               Session[]
  authEvents             AuthEvent[]
  oAuthIdentities        OAuthIdentity[]
  twoFactorMethods       UserTwoFactor[]
  recoveryCodes          RecoveryCode[]
  authChallenges         AuthChallenge[]
  passwordResetTokens    PasswordResetToken[]
  phone                  UserPhone?
  phoneChallenge         PhoneVerificationChallenge?
  telegramConnection     TelegramConnection?
  telegramLinkTokens     TelegramLinkToken[]
  notificationPreference UserNotificationPreference?

  @@map("users")
}

/// Email + password sign-in method. One per user.
model EmailAccount {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  /// Normalized (trimmed, lower-case) address.
  email           String    @unique @db.VarChar(254)
  /// Argon2id PHC string. Never logged or returned.
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  verificationTokens EmailVerificationToken[]

  @@map("email_accounts")
}

/// Single-use email verification token. Only the SHA-256 hash of the token is stored.
model EmailVerificationToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  emailAccountId String    @map("email_account_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@index([emailAccountId])
  @@map("email_verification_tokens")
}

/// Server-side browser session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt    DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  /// Last strong authentication (sign-in or reauthentication). Drives "recently authenticated" checks.
  authenticatedAt DateTime  @default(now()) @map("authenticated_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress       String?   @map("ip_address") @db.Inet
  userAgent       String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Append-only authentication security log. Never contains passwords, hashes or tokens.
model AuthEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  type      AuthEventType
  userId    String?       @map("user_id") @db.Uuid
  sessionId String?       @map("session_id") @db.Uuid
  /// Normalized email for events without a known user (e.g. failed logins).
  email     String?       @db.VarChar(254)
  ipAddress String?       @map("ip_address") @db.Inet
  userAgent String?       @map("user_agent") @db.VarChar(512)
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}

/// External sign-in providers. Add a value here to support another provider.
enum OAuthProvider {
  GOOGLE
}

/// A user's identity at an external provider. The provider's stable subject (`sub`) is the identity;
/// the email is informational only and never used to find or merge accounts after linking.
model OAuthIdentity {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  provider        OAuthProvider
  providerSubject String        @map("provider_subject")
  /// Email reported by the provider when the identity was linked; informational.
  emailAtLinkTime String?       @map("email_at_link_time") @db.VarChar(254)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// One provider identity belongs to exactly one user.
  @@unique([provider, providerSubject])
  /// A user has at most one identity per provider.
  @@unique([userId, provider])
  @@map("o_auth_identities")
}

/// Single-use password reset token. Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Second-factor methods. Add a value to support another method.
enum TwoFactorMethod {
  TOTP
}

/// An enabled second factor. A row exists only while the factor is enabled; setup in progress lives
/// in Redis, so an abandoned setup never enables anything. The secret is AES-256-GCM encrypted.
model UserTwoFactor {
  id              String          @id @default(uuid(7)) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  method          TwoFactorMethod
  /// `v<keyVersion>.<iv>.<tag>.<ciphertext>`, bound to the user as authenticated data. Never plaintext.
  encryptedSecret String          @map("encrypted_secret")
  enabledAt       DateTime        @default(now()) @map("enabled_at") @db.Timestamptz(3)
  /// Highest TOTP time step already accepted; a code can be used only once.
  lastUsedStep    Int?            @map("last_used_step")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// At most one configuration per user and method.
  @@unique([userId, method])
  @@map("user_two_factor")
}

/// Single-use recovery code. Only the SHA-256 hash is stored.
model RecoveryCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @unique @map("code_hash") @db.Char(64)
  /// Codes created together share a generation; regenerating replaces the whole set.
  generation String    @db.Uuid
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("recovery_codes")
}

enum AuthChallengePurpose {
  LOGIN_2FA
}

/// A sign-in that passed the first factor and now needs the second. Only a hash of the challenge
/// token is stored; the token itself lives in an HttpOnly cookie. Single-use and short-lived.
model AuthChallenge {
  id         String               @id @default(uuid(7)) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  purpose    AuthChallengePurpose
  tokenHash  String               @unique @map("token_hash") @db.Char(64)
  /// How the first factor was passed ("password" or "google"); recorded on the final sign-in event.
  method     String               @db.VarChar(32)
  /// Wrong codes so far; the challenge dies after a few.
  attempts   Int                  @default(0)
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?            @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_challenges")
}

/// A user's verified mobile number (E.164). A number only gets here after its SMS code was confirmed,
/// so every row is verified. Deliberately not unique: a phone is not an identity, and uniqueness would
/// let someone probe whether a number belongs to another account.
model UserPhone {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  phoneNumber String   @map("phone_number") @db.VarChar(16)
  verifiedAt  DateTime @default(now()) @map("verified_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_phones")
}

/// The one pending SMS verification a user can have. Requesting a new code replaces this row, so an
/// older code can never succeed. Only a hash of the code is stored.
model PhoneVerificationChallenge {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  /// The number being verified (E.164); copied to `user_phones` only when the code is confirmed.
  phoneNumber String    @map("phone_number") @db.VarChar(16)
  codeHash    String    @map("code_hash") @db.Char(64)
  /// Wrong codes so far; the challenge dies after a few.
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("phone_verification_challenges")
}

/// A Telegram account receiving this user's notifications. Not a sign-in method. The identity is
/// Telegram's stable numeric user id, never the (changeable) username.
model TelegramConnection {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  /// Telegram user id, as digits. One Telegram account belongs to exactly one user.
  telegramUserId String   @unique @map("telegram_user_id") @db.VarChar(20)
  /// Private chat to message (equals the user id for private chats).
  chatId         String   @map("chat_id") @db.VarChar(20)
  connectedAt    DateTime @default(now()) @map("connected_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("telegram_connections")
}

/// Single-use token carried by the bot deep link. Only its SHA-256 hash is stored; it is bound to the
/// signed-in user that asked for it.
model TelegramLinkToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("telegram_link_tokens")
}

/// Optional notification choices. Security email is required and therefore not stored; push does not
/// exist yet. A missing row means "all defaults" (see `defaultNotificationPreferences`).
model UserNotificationPreference {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  emailAccount       Boolean  @default(true) @map("email_account")
  emailTrading       Boolean  @default(true) @map("email_trading")
  emailPromotions    Boolean  @default(false) @map("email_promotions")
  telegramSecurity   Boolean  @default(true) @map("telegram_security")
  telegramAccount    Boolean  @default(true) @map("telegram_account")
  telegramTrading    Boolean  @default(true) @map("telegram_trading")
  telegramPromotions Boolean  @default(false) @map("telegram_promotions")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("notification_preferences")
}
