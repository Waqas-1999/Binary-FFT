/// Archive: every schema change ships as a migration (`pnpm db:migrate`).

generator client {
  provider            = "prisma-client"
  output              = "../services/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthEventType {
  SIGNUP_STARTED
  USER_CREATED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED
  GOOGLE_LOGIN_STARTED
  GOOGLE_LOGIN_SUCCESS
  GOOGLE_LOGIN_FAILED
  GOOGLE_LINK_STARTED
  GOOGLE_LINK_SUCCESS
  GOOGLE_LINK_FAILED
  GOOGLE_LINK_CONFLICT
}

model User {
  id         String     @id @default(uuid(7)) @db.Uuid
  /// Public user ID, starting at 10000. Generated by a PostgreSQL identity column (never reused,
  /// rejects client-supplied values) and made immutable by a trigger; see the identity migration.
  userNumber Int        @unique @default(autoincrement()) @map("user_number")
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  emailAccount EmailAccount?
  sessions     Session[]
  authEvents   AuthEvent[]
  oAuthIdentities OAuthIdentity[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// Email + password sign-in method. One per user.
model EmailAccount {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  /// Normalized (trimmed, lower-case) address.
  email           String    @unique @db.VarChar(254)
  /// Argon2id PHC string. Never logged or returned.
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  verificationTokens EmailVerificationToken[]

  @@map("email_accounts")
}

/// Single-use email verification token. Only the SHA-256 hash of the token is stored.
model EmailVerificationToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  emailAccountId String    @map("email_account_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@index([emailAccountId])
  @@map("email_verification_tokens")
}

/// Server-side browser session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

/// Append-only authentication security log. Never contains passwords, hashes or tokens.
model AuthEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  type      AuthEventType
  userId    String?       @map("user_id") @db.Uuid
  sessionId String?       @map("session_id") @db.Uuid
  /// Normalized email for events without a known user (e.g. failed logins).
  email     String?       @db.VarChar(254)
  ipAddress String?       @map("ip_address") @db.Inet
  userAgent String?       @map("user_agent") @db.VarChar(512)
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}

/// OAuth identity linking. One per user per provider.
model OAuthIdentity {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  provider      String
  providerSubject String @map("provider_subject")
  /// Email at the time the OAuth identity was linked; used for discovery, not as permanent identity.
  emailAtLinkTime String?   @map("email_at_link_time")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("o_auth_identities")
}

/// Single-use password reset token. Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  tokenHash     String   @unique @map("token_hash") @db.Char(64)
  /// The raw token travels only in the browser URL fragment (#token=...); never in query string or path.
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}