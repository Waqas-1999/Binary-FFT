# Copy to .env for local development. Server-only values: never prefix
# these with NEXT_PUBLIC_ or they will be shipped to the browser.

NODE_ENV=development
LOG_LEVEL=log

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Proxies trusted to set X-Forwarded-For. Keep "false" unless a proxy in front of the API
# overwrites or appends that header (e.g. a hop count like 1 for the production edge proxy).
# The web app's development /api rewrite does NOT qualify: it forwards the header unchanged.
API_TRUST_PROXY=false

# Customer web app URL, used in email links and as an allowed request origin.
WEB_APP_URL=http://localhost:3000

# SMTP email delivery (leave SMTP_HOST empty to log emails in development).
# Use port 465 with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Two-factor authentication. Base64 of 32 random bytes; encrypts authenticator secrets at rest.
# Generate: node -p "require('node:crypto').randomBytes(32).toString('base64')"
# Required in production. Without it (development only) two-factor setup is unavailable.
# Never commit a real key. Changing it makes stored authenticator secrets unreadable.
TWO_FACTOR_ENCRYPTION_KEY=

# Google sign-in (optional; set all three or none). The redirect URI must match the one
# registered for the OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Telegram notifications (optional; set all three or none). Server-only: never expose these to the browser.
# TELEGRAM_BOT_USERNAME is the bot's name without "@". TELEGRAM_WEBHOOK_SECRET is any random 16-256
# characters of A-Z a-z 0-9 _ - ; register the same value as `secret_token` when you call Telegram's
# setWebhook (see docs/01-architecture.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# PostgreSQL (matches infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform

# Redis (matches infrastructure/docker/docker-compose.yml)
REDIS_URL=redis://localhost:6379
