# Copy to .env for local development. Server-only values: never prefix
# these with NEXT_PUBLIC_ or they will be shipped to the browser.

NODE_ENV=development
LOG_LEVEL=log

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (matches infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform

# Redis (matches infrastructure/docker/docker-compose.yml)
REDIS_URL=redis://localhost:6379
